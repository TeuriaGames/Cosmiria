<cml>
    <View style="flex-row items-center gap-8">
        <View style="min-w-32 justify-between items-center gap-8">
            <Button onclick="Add(-1)">-</Button>
            <Text style="@(Value < 0 ? Negative : Positive)">@Value</Text>
            <Button onclick="Add(1)">+</Button>
        </View>
        <Button style="bg-#5E3A3A" onclick="Reset">Reset</Button>
    </View>
</cml>
