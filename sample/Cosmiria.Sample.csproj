<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PublishAOT>true</PublishAOT>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Cosmiria.csproj" />
    <!-- CML source generator: [Cml("File.cml")] structs get a generated Render. -->
    <ProjectReference Include="../src/Generator/Cosmiria.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**/*.cml;**/*.svg" Exclude="bin/**;obj/**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets/**/*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
