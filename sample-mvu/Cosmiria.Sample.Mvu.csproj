<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Cosmiria.csproj" />
    <ProjectReference Include="../src/Generator/Cosmiria.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**/*.cml" Exclude="bin/**;obj/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shares the font with the main sample. -->
    <None Include="../sample/Assets/Carlito-Regular.ttf" Link="Assets/Carlito-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
